RewriteEngine On

# Native e-Amusement clients send encrypted binary XRPC bodies without a
# Content-Type. The hosting WAF redirects those valid requests before PHP can
# decode them, so disable ModSecurity for this dedicated application vhost.
<IfModule mod_security2.c>
  SecRuleEngine Off
</IfModule>

# Preserve Authorization for PHP running behind CGI/FastCGI.
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

# Fallback deployment where the whole repository is the document root. Existing
# files/directories bypass the front controller, so deny source, runtime state,
# repository metadata and CLI tooling before the rewrite rules below run.
RewriteRule ^(?:src|data|tests|tools|captures|\.github|\.git)(?:/|$) - [F,L,NC]
RewriteRule ^(?:config(?:\.example|\.local)?\.php|\.env(?:\.[^/]+)?|\.gitignore|README(?:\.[A-Za-z0-9_-]+)?\.md)$ - [F,L,NC]

<FilesMatch "^(?:config(?:\.example|\.local)?\.php|\.env(?:\.[^/]+)?|\.gitignore|README(?:\.[A-Za-z0-9_-]+)?\.md)$">
  Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
